##############################################################
# TFG — Análise experimental da optimización de sistemas RAG
# Artefactos pesados, regenerables ou privados (non subir)
##############################################################

# ── Datos e índices do pipeline (≈11 GB, regenerables) ──────
rag-eval/data/**
!rag-eval/data/**/
!rag-eval/data/**/.gitkeep
rag-eval/qdrant_storage/
rag-eval/mlflow.db
mlruns/

# ── Credenciais e configuración local ───────────────────────
rag-eval/conf/local/**
!rag-eval/conf/local/.gitkeep
**/*credentials*
.env
.envrc
*.key

# ── Ferramentas locais (config persoal, non do proxecto) ────
.claude/
.telemetry
.viz/

# ── Papeleira da limpeza (revisar e borrar a man) ───────────
_papelera/

# ── Artefactos de compilación LaTeX ─────────────────────────
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
*.log

# ── Cachés Python / test ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.benchmarks/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ── Empaquetado ─────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
.Python
.python-version

# ── Entornos virtuais ───────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Ficheiros temporais soltos ──────────────────────────────
rag-eval/info/tmp*.csv
*~
*.swp
*.swo

# ── Sistema operativo / IDE ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/
